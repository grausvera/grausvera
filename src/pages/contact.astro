---
import BrandMark from "../components/brand-mark.astro";
import BrandWordmark from "../components/brand-wordmark.astro";
import ContactChannels from "../components/contact-channels.astro";
import SiteLayout from "../layouts/site-layout.astro";
---

<SiteLayout
  title="Contáctame"
  description="Los contactos y enlaces de grausvera, en un solo lugar. Código, dibujo e historias por crear."
>
  <div class="contact-page">
    <div class="contact-identity" data-drawing-surface="board">
      <BrandMark animated />
      <BrandWordmark />
    </div>
    <h1>
      Todo empieza
      <br />
      con un hola
    </h1>
    <p class="lead">
      Código, dibujo e historias por crear.
      <br />
      Si tienes una idea o simplemente quieres saludar, este es tu lugar.
    </p>
    <ContactChannels />
    <div class="contact-explore">
      <p>También puedes conocer lo que estoy creando.</p>
      <a class="primary" href="/creations">
        Explorar mis creaciones
      </a>
      <a class="text-link" href="/about">
        Conocer mi historia
      </a>
    </div>
  </div>
</SiteLayout>
