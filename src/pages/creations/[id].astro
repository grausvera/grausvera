---
import { getCollection, render, type CollectionEntry } from "astro:content";
import CreationCover from "../../components/creation-cover.astro";
import CreationMediaGallery from "../../components/creation-media-gallery.astro";
import RelatedCreations from "../../components/related-creations.astro";
import { creationTypes } from "../../data/creation-types";
import SiteLayout from "../../layouts/site-layout.astro";

interface Props {
  creation: CollectionEntry<"creations">;
  related: CollectionEntry<"creations">[];
}

// Genera las fichas y conserva las relaciones públicas en ambas direcciones.
export async function getStaticPaths() {
  const creations = await getCollection("creations");

  return creations.map((creation) => ({
    params: { id: creation.id },
    props: {
      creation,
      related: creations.filter(
        (item) =>
          item.id !== creation.id &&
          (creation.data.relatedProjectIds.includes(item.id) ||
            item.data.relatedProjectIds.includes(creation.id)),
      ),
    },
  }));
}

const { creation, related } = Astro.props;
const { data } = creation;
const { Content } = await render(creation);
---

<SiteLayout title={data.title} description={data.summary}>
  <article class="creation-detail">
    <a class="text-link" href="/creations">
      Todas las creaciones
    </a>
    <div class="page-intro">
      <p class="eyebrow">
        {creationTypes[data.type].label} · {data.status}
      </p>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
    </div>
    {data.gallery.length ? (
      <CreationMediaGallery items={data.gallery} cover={data.cover} />
    ) : (
      <CreationCover cover={data.cover} />
    )}
    {(data.role || data.tools.length > 0) && (
      <dl class="creation-facts">
        {data.role && (
          <div>
            <dt>Mi aporte</dt>
            <dd>{data.role}</dd>
          </div>
        )}
        {data.tools.length > 0 && (
          <div>
            <dt>Herramientas</dt>
            <dd class="tool-tags">
              {data.tools.map((tool) => (
                <a
                  class="tool-tag"
                  href={`/creations?tool=${encodeURIComponent(tool)}`}
                >
                  {tool}
                </a>
              ))}
            </dd>
          </div>
        )}
      </dl>
    )}
    <div class="creation-body">
      <div class="creation-prose">
        <Content />
      </div>
      {data.highlights && (
        <>
          <h2 class="creation-body-heading">{data.highlights.title}</h2>
          <div
            class="creation-body-columns"
            style={{ "--highlight-cols": data.highlights.items.length }}
          >
            {data.highlights.items.map(({ title, text }) => (
              <div class="creation-body-highlights-stack">
                <div class="website-highlight creation-body-highlight feature-highlight">
                  <div class="feature-highlight-copy">
                    <h3 class="creation-body-highlight-title">{title}</h3>
                    <p class="creation-body-paragraph">{text}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
    {data.website && (
      <div
        class="website-access-links"
        role="group"
        aria-label="Explorar esta creación"
      >
        <a href={data.website.path} target="_blank" rel="noopener noreferrer">
          <svg
            class="contact-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <use href="/contact-icons.svg#globe"></use>
          </svg>
          <span>Explorar el sitio</span>
          <span class="sr-only"> (se abre en una pestaña nueva)</span>
        </a>
        {data.website.responsive && (
          <a href={`/creations/${creation.id}/responsive`}>
            <svg
              class="contact-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <use href="/contact-icons.svg#devices"></use>
            </svg>
            <span>Ver diseño responsive</span>
          </a>
        )}
        {data.website.repository && (
          <a
            href={data.website.repository}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              class="contact-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <use href="/contact-icons.svg#github"></use>
            </svg>
            <span>Ver repositorio</span>
            <span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>
        )}
      </div>
    )}
    <RelatedCreations
      items={related}
      isMainWebsite={data.website?.path === "/"}
    />
  </article>
</SiteLayout>

<style>
  .creation-prose {
    display: grid;
    gap: inherit;
  }

  .creation-prose :global(:is(h2, h3, p)) {
    margin: 0;
    padding: 0;
    font-family: "DM Sans", sans-serif;
    letter-spacing: normal;
    overflow-wrap: anywhere;
  }

  .creation-prose :global(h2) {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.5;
  }

  .creation-prose :global(h3) {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.5;
  }

  .creation-prose :global(p) {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
  }
</style>
