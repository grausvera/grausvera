---
import { getEntry, render, type CollectionEntry } from "astro:content";
import CreationCover from "../../components/creation-cover.astro";
import RelatedCreations from "../../components/related-creations.astro";
import { formatEntryDate, getPublishedEntries } from "../../data/bitacora";
import SiteLayout from "../../layouts/site-layout.astro";

interface Props {
  entry: CollectionEntry<"bitacora">;
}

// Genera una ruta por entrada publicada y deja los borradores fuera del sitio compilado.
export async function getStaticPaths() {
  const entries = await getPublishedEntries();

  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const creation = data.creation ? await getEntry(data.creation) : undefined;
const cover = data.cover ?? creation?.data.cover;
---

<SiteLayout title={data.title} description={data.summary}>
  <article class="creation-detail journal-entry">
    <a class="text-link" href="/bitacora">
      Volver a la bitácora
    </a>
    <header class="page-intro">
      <p class="eyebrow">
        <time datetime={data.date}>{formatEntryDate(data.date)}</time>
        {data.category && <span> · {data.category}</span>}
      </p>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
    </header>
    {cover && <CreationCover cover={cover} />}
    <div class="creation-body journal-content">
      <Content />
    </div>
    {data.tags.length > 0 && (
      <ul class="tool-tags entry-tags" aria-label="Etiquetas">
        {data.tags.map((tag) => (
          <li class="creation-type">{tag}</li>
        ))}
      </ul>
    )}
    {creation && (
      <RelatedCreations items={[creation]} heading="Creación relacionada" />
    )}
  </article>
</SiteLayout>

<style>
  .journal-content :global(:is(h2, h3, p, pre, ul, ol, blockquote)) {
    margin-block: 0;
    overflow-wrap: anywhere;
  }

  .journal-content :global(:where(p, li, figcaption) a[href]) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .journal-content
    :global(:where(p, li, figcaption) a[href]:is(:hover, :focus-visible)) {
    text-decoration-thickness: 2px;
  }

  .journal-content :global(img) {
    max-width: 100%;
    height: auto;
  }

  .journal-content :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border-radius: var(--control-radius);
  }

  .journal-content {
    max-width: 66ch;
    margin-inline: auto;
    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.75;
  }

  .journal-content :global(h2) {
    margin-block-start: 18px;
    font-size: clamp(21px, 3vw, 26px);
    line-height: 1.3;
  }

  .journal-content :global(.journal-figure) {
    margin: 12px 0;
  }

  .journal-content :global(.journal-experiment) {
    margin-block: 12px;
    padding: 0 clamp(10px, 3vw, 22px);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow-wrap: anywhere;
  }

  .journal-content :global(figcaption) {
    margin-block-start: 8px;
    color: var(--muted);
    font-size: 13px;
  }

  .entry-tags {
    padding: 0;
    margin-block: 24px;
    list-style: none;
  }
</style>
