---
interface Props {
  cover: { light: string; dark?: string; alt: string };
}

const { cover } = Astro.props;
---

<div class="creation-cover creation-cover-custom">
  <span class="themed-image">
    <img
      class="themed-image-light"
      src={cover.light}
      alt={cover.alt}
      width="1600"
      height="900"
      loading="lazy"
      decoding="async"
    />
    <img
      class="themed-image-dark"
      src={cover.dark ?? cover.light}
      alt={cover.alt}
      width="1600"
      height="900"
      loading="lazy"
      decoding="async"
    />
  </span>
</div>
