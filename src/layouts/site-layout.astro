---
import Menu from "@grausvera/unancha/astro/menu";
import Moon from "@grausvera/unancha/astro/moon";
import Sun from "@grausvera/unancha/astro/sun";
import { noIndex } from "../data/site-metadata";
import BrandWordmark from "../components/brand-wordmark.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description: string;
  indexable?: boolean;
  notFound?: boolean;
}

const { title, description, indexable = true, notFound = false } = Astro.props;
const pageTitle = title ? `${title} · grausvera` : "grausvera";
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(pathname, Astro.site).href;
const socialImage = new URL("/brand/social.png", Astro.site).href;
const navigation = [
  { href: "/bitacora", label: "Bitácora" },
  { href: "/creations", label: "Creaciones" },
  { href: "/about", label: "Sobre mí" },
  { href: "/contact", label: "Contacto" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    {(noIndex || !indexable || notFound) && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    {!notFound && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="grausvera" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Identidad visual de grausvera" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />
        <meta
          name="twitter:image:alt"
          content="Identidad visual de grausvera"
        />
      </>
    )}
    <script is:inline>
      // Aplica el tema antes de pintar para evitar un destello al abrir la página.
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("grausvera-theme");
        } catch {
          // El navegador puede impedir el almacenamiento; se usa el tema del sistema.
        }

        const dark =
          theme === "dark" ||
          (theme !== "light" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="grausvera, inicio">
        <BrandWordmark />
      </a>
      <div class="header-actions">
        <button
          class="menu-toggle"
          type="button"
          aria-label="Menú"
          aria-expanded="false"
          aria-controls="site-navigation"
        >
          <Menu width="18" height="18" stroke-width="1.6" />
          <span>Menú</span>
        </button>
        <nav
          id="site-navigation"
          class="site-navigation"
          aria-label="Principal"
        >
          {navigation.map(({ href, label }) => (
            <a
              href={href}
              aria-current={
                Astro.url.pathname.replace(/\/$/, "") === href
                  ? "page"
                  : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
        <div class="header-icon-actions">
          <button class="theme-toggle" type="button" aria-label="Cambiar tema">
            <Sun class="theme-sun" width="20" height="20" stroke-width="1.6" />
            <Moon
              class="theme-moon"
              width="20"
              height="20"
              stroke-width="1.6"
            />
          </button>
        </div>
      </div>
    </header>
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} grausvera</span>
      <a href="/">Volver al inicio</a>
    </footer>
    <div class="brand-cursor-effects" aria-hidden="true">
      <template>
        <svg
          class="brand-cursor-spark"
          width="30"
          height="30"
          viewBox="-15 -15 30 30"
        >
          <path d="M0-9C1-3 3-1 9 0 3 1 1 3 0 9-1 3-3 1-9 0-3-1-1-3 0-9Z" />
          <path class="spark-detail" d="m10-9 1-3m-23 22-2 2M10 10l2 2" />
        </svg>
      </template>
    </div>
    <canvas class="brand-page-drawing-canvas" aria-hidden="true"></canvas>
  </body>
</html>

<script>
  import "../scripts/drawing/cursor-effects";
  import "../scripts/drawing/page-drawing";
  import "../scripts/site-controls";
</script>
